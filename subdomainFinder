#!/bin/bash
# master-subdomain.sh - Finds ALL subdomains for ANY target

TARGET="example.com"  # CHANGE THIS
OUTPUT_DIR="recon-$TARGET"

mkdir -p $OUTPUT_DIR
cd $OUTPUT_DIR

# ============================================
# PHASE 1: PASSIVE SUBDOMAIN ENUMERATION
# ============================================

echo "[1/8] Running passive enumeration..."

# Subfinder (Fast, good for wide scope)
subfinder -d $TARGET -all -recursive -silent -o subfinder.txt

# Assetfinder (Good for root domain)
assetfinder --subs-only $TARGET > assetfinder.txt

# Amass (Deep but slow - use passive only for speed)
amass enum -passive -d $TARGET -o amass.txt

# Findomain (Good certificate source)
findomain -t $TARGET -q -u findomain.txt

# Chaos (ProjectDiscovery's dataset)
chaos -d $TARGET -silent -o chaos.txt 2>/dev/null

# ============================================
# PHASE 2: CERTIFICATE TRANSPARENCY
# ============================================

echo "[2/8] Querying Certificate Transparency logs..."

# crt.sh
curl -s "https://crt.sh/?q=%.$TARGET&output=json" | jq -r '.[].name_value' | sed 's/\*\.//g' | sort -u > crtsh.txt

# Certspotter
curl -s "https://certspotter.com/api/v0/certs?domain=$TARGET" | jq -r '.[].dns_names[]' | sed 's/\*\.//g' | sort -u > certspotter.txt

# Facebook CT
curl -s "https://graph.facebook.com/certificates?query=%.$TARGET&fields=name" | jq -r '.data[].name' | sed 's/\*\.//g' | sort -u > facebook-ct.txt

# ============================================
# PHASE 3: ALTERNATE WORDLISTS & PERMUTATIONS
# ============================================

echo "[3/8] Generating permutations..."

# Common subdomain wordlist
cat > common.txt << 'EOF'
