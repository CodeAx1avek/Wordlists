# Generate permutations from known subdomains
cat subfinder.txt assetfinder.txt amass.txt 2>/dev/null | sort -u > all-passive.txt

# Add common prefixes/suffixes
cat all-passive.txt | while read sub; do
    echo "dev-$sub"
    echo "staging-$sub"
    echo "test-$sub"
    echo "old-$sub"
    echo "new-$sub"
    echo "$sub-dev"
    echo "$sub-staging"
done >> permutations.txt

# ============================================
# PHASE 4: DNS BRUTE FORCE (Optional but powerful)
# ============================================

echo "[4/8] Brute forcing subdomains (this takes time)..."

# Using puredns for fast brute force
if command -v puredns &> /dev/null; then
    puredns bruteforce common.txt $TARGET -r /usr/share/wordlists/dns/resolvers.txt -o puredns.txt
else
    # Alternative using dnsx with wordlist
    dnsx -l common.txt -o dnsx-brute.txt -r 1.1.1.1,8.8.8.8 -t 1000 -domain $TARGET -silent
fi

# ============================================
# PHASE 5: ALTERNATIVE DATA SOURCES
# ============================================

echo "[5/8] Checking alternative sources..."

# AlienVault OTX
curl -s "https://otx.alienvault.com/api/v1/indicators/domain/$TARGET/passive_dns" | jq -r '.passive_dns[].hostname' 2>/dev/null | sed 's/\*\.//g' >> otx.txt

# SecurityTrails (free API limit)
curl -s "https://securitytrails.com/list/apex_domain/$TARGET" | grep -oP '(?<=<td>)[^<]+\.$TARGET' >> securitytrails.txt 2>/dev/null

# ThreatCrowd
curl -s "https://www.threatcrowd.org/searchApi/v2/domain/report/?domain=$TARGET" | jq -r '.subdomains[]' 2>/dev/null >> threatcrowd.txt

# BufferOver
curl -s "https://dns.bufferover.run/dns?q=$TARGET" | jq -r '.FDNS_A[]' 2>/dev/null | cut -d',' -f2 >> bufferover.txt

# ============================================
# PHASE 6: GITHUB CODE SEARCH (Golden Source)
# ============================================

echo "[6/8] Searching GitHub for subdomains..."

# Using github-subdomains.py (if installed)
if [ -f ~/tools/github-subdomains.py ]; then
    python3 ~/tools/github-subdomains.py -d $TARGET -t YOUR_GITHUB_TOKEN -o github.txt
fi

# Alternative: Download known configs from GitHub
curl -s "https://raw.githubusercontent.com/gwen001/github-search/master/github-subdomains.py" | python3 - -d $TARGET -t $GITHUB_TOKEN

# ============================================
# PHASE 7: IP SPACE DISCOVERY (Critical)
# ============================================

echo "[7/8] Discovering IP addresses and ASNs..."

# Get ASN for target
whois $TARGET | grep -i "origin:" | awk '{print $2}' > asn.txt

# Get all IPs in that ASN (if ASN found)
if [ -s asn.txt ]; then
    while read asn; do
        whois -h whois.radb.net -- "-i origin $asn" | grep -Eo "([0-9.]+){4}/[0-9]+" >> ips.txt
    done < asn.txt
fi

# Convert IP ranges to reverse DNS
cat ips.txt | while read cidr; do
    dnsx -ptr -a -resp-only -l <(nmap -sL -n $cidr | awk '/Nmap scan report/{print $NF}') -o reverse-dns.txt
done

# ============================================
# PHASE 8: COMBINE & DEDUPLICATE
# ============================================

echo "[8/8] Combining and deduplicating..."

# Combine all sources
cat *.txt 2>/dev/null | \
    grep -v "null\|error\|Not Found" | \
    sed 's/\*\.//g' | \
    sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | \
    sed 's/[0-9]\+\.[0-9]\+\.[0-9]\+\.[0-9]\+//g' | \
    grep -E "([a-zA-Z0-9-]+\.)+$TARGET" | \
    sort -u | tee all-subdomains.txt

# Filter valid subdomains (have at least 3 parts)
grep -E "([a-zA-Z0-9-]+\.){2,}$TARGET" all-subdomains.txt > deep-subdomains.txt

echo "=========================================="
echo "RESULTS SAVED IN $OUTPUT_DIR"
echo "=========================================="
echo "Total unique subdomains: $(wc -l all-subdomains.txt)"
echo "Deep subdomains: $(wc -l deep-subdomains.txt)"
echo ""
echo "Files created:"
echo "  - all-subdomains.txt (ALL found)"
echo "  - deep-subdomains.txt (3+ levels deep)"
echo "  - subfinder.txt (subfinder only)"
echo "  - permutations.txt (generated variants)"
